---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<a class="name" href="/">{SITE_TITLE}</a>
	</nav>
</header>
<style>
	header {
		width: var(--content-width);
		max-width: calc(100% - 3em);
		margin: 0 auto;
		padding: 2.5em 0 0;
		background: none;
		box-shadow: none;
		border: none;
	}
	nav {
		display: flex;
		align-items: baseline;
		justify-content: flex-start;
	}
	.name {
		color: var(--text-strong);
		font-weight: 600;
	}
	@media (max-width: 720px) {
		header {
			max-width: calc(100% - 2.5em);
			padding-top: 2em;
		}
	}
</style>
